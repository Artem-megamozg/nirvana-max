INCOME_PM_THRESHOLD=25000

# === GigaChat (опционально) ===
# Ключ авторизации из кабинета GigaChat API (developers.sber.ru).
# Если не задан — «Почему подходит» работает на шаблоне.
GIGACHAT_AUTH_KEY=
