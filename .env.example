# === MAX Bot ===
# Токен бота из кабинета MAX for Developers
MAX_TOKEN=

# Username бота — для кнопки open_app
MAX_BOT_USERNAME=t687_hakaton_max_bot

# Публичный HTTPS-URL мини-приложения
MAX_WEBAPP_URL=https://litvinskiy-developer.online/app/

# Секрет для проверки вебхука MAX
WEBHOOK_SECRET=

# === Настройки ===
